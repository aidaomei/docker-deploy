#!/bin/bash
# ======================== 全局公共配置 ========================
APP_ENV="prod"                  # 环境标识（prod/test/dev）
RESTART_POLICY="always"         # 所有服务默认重启策略
LOG_ROOT_DIR="/opt/app/logs"    # 所有服务日志根目录（用户自行创建并挂载）
VERSION_LOG_PATH="${LOG_ROOT_DIR}/app_stack_version.log"  # 操作审计日志路径

# ======================== Nginx服务配置（4核4G服务器专用）====================
NGINX_IMAGE="nginx:1.24-alpine"                          # Nginx镜像（可替换为自定义镜像）
NGINX_PORT="80:80"                                       # 前端访问端口
NGINX_CONF_DIR="/opt/app/nginx/conf"                     # 配置文件目录（用户自行创建）
NGINX_HTML_DIR="/opt/app/nginx/html"                     # 前端静态资源目录（用户自行创建）
NGINX_LOG_DIR="${LOG_ROOT_DIR}/nginx"                    # 日志目录（用户自行创建）
NGINX_CPU="0.5"                                          # 最多占用0.5核CPU（轻量需求）
NGINX_MEM="256m"                                         # 最多占用256M内存（轻量需求）

# ======================== Java后端服务配置（4核4G服务器专用）====================
BACKEND_IMAGE="java-backend-app:5.0"  # 你的阿里云Java镜像
BACKEND_PORT="8081:8080"                                 # 后端端口映射
BACKEND_CONF_DIR="/opt/app/backend/conf"                 # 配置文件目录（用户自行创建，可选）
BACKEND_LOG_DIR="${LOG_ROOT_DIR}/backend"                # 日志目录（用户自行创建）
BACKEND_CPU="1.5"                                         # 最多占用1.5核CPU（核心算力倾斜）
BACKEND_MEM="1.2g"                                        # 最多占用1.2G内存（满足Java运行需求）
JAVA_OPTS="-Xms512m -Xmx1g"                              # JVM堆内存：初始512M，最大1G（≤ Docker内存限制）

# ======================== MySQL数据库配置（4核4G服务器专用）====================
MYSQL_IMAGE="mysql:8.0"                                  # MySQL镜像版本
MYSQL_PORT="3306:3306"                                   # MySQL端口映射
MYSQL_DB="app_db"                                        # 自动创建的业务数据库名
MYSQL_USER="app_user"                                    # 后端专用数据库用户（非root）
MYSQL_ROOT_PWD="Root@123456"                             # root密码（复杂密码）
MYSQL_USER_PWD="AppUser@123456"                          # 后端用户密码（复杂密码）
MYSQL_CONF_DIR="/opt/app/mysql/conf"                     # 配置文件目录（用户自行创建）
MYSQL_LOG_DIR="${LOG_ROOT_DIR}/mysql"                    # 日志目录（用户自行创建）
MYSQL_CPU="1.0"                                          # 最多占用1核CPU（平衡需求）
MYSQL_MEM="1g"                                           # 最多占用1G内存（内存敏感，优化缓存）
# 核心数据存储在命名卷 mysql-data 中，Docker自动管理

# ======================== Redis缓存配置（4核4G服务器专用）====================
REDIS_IMAGE="redis:7.2-alpine"                           # Redis镜像版本
REDIS_PORT="6379:6379"                                   # Redis端口映射
REDIS_PASSWORD="redis123"
REDIS_PWD="redis123"                                 # Redis密码（复杂密码）
REDIS_DB="0"                                             # 后端使用的Redis数据库编号
REDIS_CONF_DIR="/opt/app/redis/conf"                     # 配置文件目录（用户自行创建）
REDIS_LOG_DIR="${LOG_ROOT_DIR}/redis"                    # 日志目录（用户自行创建）
REDIS_CPU="0.3"                                          # 最多占用0.3核CPU（低消耗）
REDIS_MEM="512m"                                         # 最多占用512M内存（按需分配）
# 核心数据存储在命名卷 redis-data 中，Docker自动管理
