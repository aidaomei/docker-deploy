# 核心基础参数（支撑目录、磁盘、Compose 配置检查）
DEPLOY_ROOT="/opt/app"
LOG_ROOT="/opt/app/logs"
COMPOSE_FILE="/opt/app/conf/docker-compose.yml"

# 多服务核心参数（支撑端口占用、镜像存在性、容器状态检查）
# Nginx 服务
SERVICE_NGINX_NAME="app-nginx"
SERVICE_NGINX_IMAGE="nginx:1.24-alpine"
SERVICE_NGINX_PORT="80:80"
# Java 后端服务
SERVICE_BACKEND_NAME="app-backend"
SERVICE_BACKEND_IMAGE="java-backend-app:6.0"
SERVICE_BACKEND_PORT="8081:8080"
# MySQL 服务
SERVICE_MYSQL_NAME="app-mysql"
SERVICE_MYSQL_IMAGE="mysql:8.0"
SERVICE_MYSQL_PORT="3306:3306"

# Docker 存储配置参数（支撑磁盘空间检查，灵活调整阈值）
DOCKER_STORAGE_DIR="/var/lib/docker"
MIN_DOCKER_SPACE="5"  # 单位：GB
MIN_DEPLOY_SPACE="10" # 单位：GB
